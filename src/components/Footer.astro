---
import { getEinstellung, url } from '../lib/utils';
const a = await getEinstellung('allgemein');
const jahr = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="checker" aria-hidden="true"></div>
  <div class="wrap cols">
    <div>
      <p class="f-title">{a.vereinsname}</p>
      <p class="muted">{a.slogan}</p>
      {a.instagram && (
        <a class="social" href={a.instagram} target="_blank" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/></svg>
          Folge uns auf Instagram
        </a>
      )}
    </div>
    <div>
      <p class="f-head">Theater</p>
      <address set:html={a.theaterAdresse.replace(/\n/g, '<br>')} />
      {a.kartenLink && <a href={a.kartenLink} target="_blank" rel="noopener">Auf der Karte anzeigen →</a>}
    </div>
    <div>
      <p class="f-head">Post</p>
      <address set:html={a.postAdresse.replace(/\n/g, '<br>')} />
      <a href={`mailto:${a.email}`}>{a.email}</a>
    </div>
    <div>
      <p class="f-head">Schnellzugriff</p>
      <ul>
        <li><a href={url('/tickets')}>Tickets / Reservation</a></li>
        <li><a href={url('/archiv')}>Archiv</a></li>
        <li><a href={url('/mitglied-werden')}>Mitglied werden</a></li>
        <li><a href={url('/mitglieder')}>Mitgliederbereich</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap bottom">
    <span>© {jahr} {a.vereinsname}</span>
    <a href={url('/admin/')} rel="nofollow">Admin</a>
  </div>
</footer>

<style>
  .site-footer { background: var(--ink); color: #d9d4c7; margin-top: clamp(48px, 8vw, 96px); font-size: 0.96rem; }
  .checker { --s: 10px; }
  .cols { display: grid; gap: 32px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); padding: 56px 0 40px; }
  .f-title { font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; color: var(--white); margin: 0 0 6px; }
  .f-head { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--yellow); margin: 0 0 10px; }
  .muted { color: #a7a193; }
  address { font-style: normal; margin-bottom: 8px; }
  a { color: var(--white); text-decoration-color: var(--yellow); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .social { display: inline-flex; align-items: center; gap: 8px; margin-top: 6px; text-decoration: none; color: var(--yellow); font-weight: 600; }
  .bottom { display: flex; justify-content: space-between; gap: 16px; border-top: 1px solid rgb(255 255 255 / 0.1); padding: 18px 0 26px; font-size: 0.85rem; color: #8f897c; }
  .bottom a { color: #8f897c; }
</style>
