---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { teaser, url } from '../lib/utils';

interface Props { stueck: CollectionEntry<'stuecke'>; base?: string }
const { stueck, base = '/archiv' } = Astro.props;
const { titel, jahr, zeitraum, bild } = stueck.data;
---

<a class="card stueck" href={url(`${base}/${stueck.id}/`)}>
  <div class="stueck__media">
    {bild ? (
      <Image src={bild} alt="" width={640} height={420} fit="cover" />
    ) : (
      <div class="stueck__placeholder" aria-hidden="true"><span>{zeitraum ?? jahr}</span></div>
    )}
    <span class="badge">{zeitraum ?? jahr}</span>
  </div>
  <div class="card__body">
    <h3>{titel}</h3>
    <p>{teaser(stueck.body, 140).replace(new RegExp(`^[„“"]?${titel.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}[“"]?\\s*`, 'i'), '')}</p>
  </div>
</a>

<style>
  .stueck__media { position: relative; aspect-ratio: 3 / 2; background: var(--ink); overflow: hidden; }
  .stueck__media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .stueck:hover .stueck__media :global(img) { transform: scale(1.04); }
  .stueck__media .badge { position: absolute; left: 14px; top: 14px; }
  .stueck__placeholder {
    width: 100%; height: 100%; display: grid; place-items: center;
    background: conic-gradient(#1f1d19 25%, #2b2822 0 50%, #1f1d19 0 75%, #2b2822 0) 0 0 / 48px 48px;
  }
  .stueck__placeholder span { font-family: var(--font-display); font-size: 2.6rem; font-weight: 800; color: var(--yellow); }
</style>
