---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
  title?: string;
  /** Bildunterschriften, gleiche Reihenfolge wie images */
  captions?: (string | undefined)[];
  /** Schwarzweiss-Darstellung (Startseite während der Saison); Farbe blitzt beim Darüberfahren auf */
  mono?: boolean;
  showHeading?: boolean;
}
const { images, title = 'Bildergalerie', captions = [], mono = false, showHeading = true } = Astro.props;

const items = await Promise.all(
  images.map(async (img, i) => {
    const thumb = await getImage({ src: img, width: 480, height: 360, fit: 'cover', format: 'webp' });
    const full = await getImage({ src: img, width: Math.min(img.width, 1800), format: 'webp' });
    return { thumb: thumb.src, full: full.src, i, w: img.width, h: img.height };
  }),
);
---

{items.length > 0 && (
  <section class:list={['gallery', { 'gallery--mono': mono }]} aria-label={title}>
    {showHeading && <h2 class="gallery__title">{title} <span>{items.length} Bilder</span></h2>}
    <ul class="gallery__grid">
      {items.map((it) => (
        <li>
          <a href={it.full} data-index={it.i} data-w={it.w} data-h={it.h}>
            <img src={it.thumb} alt={captions[it.i] || `${title} – Bild ${it.i + 1}`} width="480" height="360" loading="lazy" decoding="async" />
            {captions[it.i] && <span class="gallery__caption">{captions[it.i]}</span>}
          </a>
        </li>
      ))}
    </ul>
    <dialog class="lightbox" aria-label="Bildansicht">
      <img alt="" />
      <p class="lightbox__count" aria-live="polite"></p>
      <button class="lb-btn lb-close" aria-label="Schliessen">✕</button>
      <button class="lb-btn lb-prev" aria-label="Vorheriges Bild">‹</button>
      <button class="lb-btn lb-next" aria-label="Nächstes Bild">›</button>
    </dialog>
  </section>
)}

<style>
  .gallery { margin-top: 3rem; }
  .gallery__title { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .gallery__title span { font-family: var(--font-body); font-size: 0.9rem; font-weight: 500; color: var(--muted); }
  .gallery__grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; grid-template-columns: repeat(auto-fill, minmax(min(46%, 200px), 1fr)); }
  .gallery__grid a { display: block; border-radius: 10px; overflow: hidden; aspect-ratio: 4 / 3; background: var(--paper-2); }
  .gallery__grid img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.35s ease, filter 0.35s; }
  .gallery__grid a:hover img { transform: scale(1.04); }
  .gallery__grid a { position: relative; }
  .gallery__caption {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 22px 12px 9px;
    font-size: 0.82rem; font-weight: 550; color: #fff; line-height: 1.3;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.7));
  }

  /* Schwarzweiss-Modus: Mosaik, Farbe als kleiner Vorgeschmack beim Darüberfahren */
  .gallery--mono { margin-top: 0; }
  .gallery--mono .gallery__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: 1fr; }
  .gallery--mono .gallery__grid li:first-child { grid-column: span 2; grid-row: span 2; }
  .gallery--mono .gallery__grid a { aspect-ratio: auto; height: 100%; min-height: 140px; }
  .gallery--mono .gallery__grid img { filter: grayscale(1) contrast(1.08); transition: transform 0.35s ease, filter 0.6s ease; }
  .gallery--mono .gallery__grid a:hover img, .gallery--mono .gallery__grid a:focus-visible img { filter: grayscale(0); }
  .gallery--mono .lightbox img { filter: grayscale(1) contrast(1.08); }
  @media (max-width: 700px) {
    .gallery--mono .gallery__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .lightbox { border: 0; padding: 0; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100dvh; background: rgb(12 11 10 / 0.95); color: #fff; }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox::backdrop { background: rgb(0 0 0 / 0.7); }
  .lightbox img { max-width: min(92vw, 1800px); max-height: 84dvh; width: auto; height: auto; border-radius: 6px; object-fit: contain; }
  .lightbox__count { position: absolute; bottom: 16px; left: 0; right: 0; text-align: center; margin: 0; font-size: 0.9rem; color: #bbb; }
  .lb-btn { position: absolute; background: rgb(255 255 255 / 0.1); color: #fff; border: 0; width: 52px; height: 52px; border-radius: 50%; font-size: 1.8rem; line-height: 1; cursor: pointer; display: grid; place-items: center; }
  .lb-btn:hover { background: var(--yellow); color: var(--ink); }
  .lb-close { top: 16px; right: 16px; font-size: 1.2rem; }
  .lb-prev { left: 16px; top: 50%; translate: 0 -50%; }
  .lb-next { right: 16px; top: 50%; translate: 0 -50%; }
  @media (max-width: 600px) { .lb-prev, .lb-next { top: auto; bottom: 8px; translate: none; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.gallery').forEach((gallery) => {
    const links = [...gallery.querySelectorAll<HTMLAnchorElement>('.gallery__grid a')];
    const dlg = gallery.querySelector<HTMLDialogElement>('.lightbox')!;
    const img = dlg.querySelector('img')!;
    const count = dlg.querySelector('.lightbox__count')!;
    let idx = 0;
    const show = (i: number) => {
      idx = (i + links.length) % links.length;
      img.src = links[idx].href;
      img.alt = links[idx].querySelector('img')?.alt ?? '';
      count.textContent = `${idx + 1} / ${links.length}`;
      const next = new Image(); next.src = links[(idx + 1) % links.length].href;
    };
    links.forEach((a, i) => a.addEventListener('click', (e) => { e.preventDefault(); show(i); dlg.showModal(); }));
    dlg.querySelector('.lb-close')!.addEventListener('click', () => dlg.close());
    dlg.querySelector('.lb-prev')!.addEventListener('click', () => show(idx - 1));
    dlg.querySelector('.lb-next')!.addEventListener('click', () => show(idx + 1));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(idx + 1);
      if (e.key === 'ArrowLeft') show(idx - 1);
    });
    let x0: number | null = null;
    dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    dlg.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) show(idx + (dx < 0 ? 1 : -1));
      x0 = null;
    });
  });
</script>
