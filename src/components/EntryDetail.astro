---
/** Gemeinsame Detailansicht für Stücke und Vereinsanlässe */
import Base from '../layouts/Base.astro';
import Gallery from './Gallery.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { url } from '../lib/utils';

interface Nav { href: string; label: string }
interface Props {
  title: string;
  meta: string;
  kicker: string;
  backHref: string;
  backLabel: string;
  bild?: ImageMetadata;
  galerie: ImageMetadata[];
  description?: string;
  prev?: Nav;
  next?: Nav;
}
const { title, meta, kicker, backHref, backLabel, bild, galerie, description, prev, next } = Astro.props;
---

<Base title={title} description={description} image={bild ?? galerie[0]}>
  <article>
    <header class="detail-head">
      <div class="wrap detail-head__inner">
        <div>
          <a class="back" href={url(backHref)}>← {backLabel}</a>
          <span class="kicker">{kicker}</span>
          <h1>{title}</h1>
          <span class="badge">{meta}</span>
        </div>
        {bild && (
          <div class="detail-head__media">
            <Image src={bild} alt="" width={900} loading="eager" />
          </div>
        )}
      </div>
    </header>
    <div class="wrap">
      <div class="prose"><slot /></div>
      <Gallery images={galerie} title={`Bilder – ${title}`} />
      {(prev || next) && (
        <nav class="pager" aria-label="Weitere Einträge">
          {prev ? <a href={url(prev.href)} class="card"><small>← Neuer</small><span>{prev.label}</span></a> : <span />}
          {next ? <a href={url(next.href)} class="card pager__next"><small>Älter →</small><span>{next.label}</span></a> : <span />}
        </nav>
      )}
    </div>
  </article>
</Base>

<style>
  .detail-head { padding: clamp(32px, 6vw, 72px) 0 clamp(28px, 4vw, 48px); }
  .detail-head__inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(24px, 5vw, 64px); align-items: center; }
  .detail-head__inner:not(:has(.detail-head__media)) { grid-template-columns: 1fr; }
  .detail-head h1 { margin: 0.3em 0 0.4em; font-size: clamp(2.2rem, 6vw, 4.2rem); }
  .detail-head__media :global(img) { border-radius: var(--radius); box-shadow: var(--shadow); width: 100%; max-height: 520px; object-fit: cover; }
  .back { display: block; width: fit-content; margin-bottom: 18px; font-size: 0.92rem; font-weight: 600; text-decoration: none; color: var(--muted); }
  .back:hover { color: var(--ink); }
  @media (max-width: 800px) { .detail-head__inner { grid-template-columns: 1fr; } .detail-head__media { order: -1; } }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 56px; }
  .pager .card { padding: 18px 22px; gap: 2px; }
  .pager small { color: var(--muted); font-weight: 600; }
  .pager span { font-family: var(--font-display); font-weight: 650; font-size: 1.15rem; }
  .pager__next { text-align: right; }
</style>
