---
import Page from '../../layouts/Page.astro';
import { Image } from 'astro:assets';
import { formatDatum, getAnlaesse, url } from '../../lib/utils';

const anlaesse = await getAnlaesse();
---

<Page title="Vereinsanlässe" kicker="Verein" lead="Ausflüge, Jahresversammlungen und Feste: Das Vereinsleben neben der Bühne.">
  <div class="grid">
    {anlaesse.map((a) => {
      const bild = a.data.bild ?? a.data.galerie[0];
      return (
        <a class="card" href={url(`/anlaesse/${a.id}/`)}>
          <div class="media">
            {bild && <Image src={bild} alt="" width={640} height={420} fit="cover" />}
          </div>
          <div class="card__body">
            <span class="date">{formatDatum(a.data.datum)}</span>
            <h3>{a.data.titel}</h3>
            {a.data.galerie.length > 0 && <p>{a.data.galerie.length} Bilder</p>}
          </div>
        </a>
      );
    })}
  </div>
</Page>

<style>
  .media { aspect-ratio: 3 / 2; background: var(--paper-2); overflow: hidden; }
  .media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .date { font-size: 0.82rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
</style>
