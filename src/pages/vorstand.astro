---
import Page from '../layouts/Page.astro';
import { Image } from 'astro:assets';
import { getEinstellung } from '../lib/utils';

const v = await getEinstellung('vorstand');
---

<Page title={v.titel} kicker="Verein" lead="Die Menschen, die hinter den Kulissen die Fäden ziehen.">
  <ul class="team">
    {v.mitglieder.map((m) => (
      <li class="card">
        <div class="photo">
          {m.foto ? <Image src={m.foto} alt={m.name} width={400} height={520} fit="cover" /> : <span aria-hidden="true">{m.name.split(' ').map((n) => n[0]).join('')}</span>}
        </div>
        <div class="card__body">
          <span class="role">{m.funktion}</span>
          <h3>{m.name}</h3>
          {m.email && <a href={`mailto:${m.email}`}>{m.email}</a>}
        </div>
      </li>
    ))}
  </ul>
</Page>

<style>
  .team { list-style: none; margin: 0; padding: 0; display: grid; gap: 24px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); }
  .photo { aspect-ratio: 4 / 5; background: var(--ink); display: grid; place-items: center; overflow: hidden; }
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .photo span { font-family: var(--font-display); font-size: 3rem; color: var(--yellow); font-weight: 800; }
  .role { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .card__body a { font-size: 0.9rem; word-break: break-word; }
</style>
